# ── Telegram bot ──────────────────────────────────────────────────────────────
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tu Chat ID personal. Envía /start al bot para obtenerlo.
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Hora local a la que el bot te recuerda hacer el check-in (formato HH:MM)
DAILY_REMINDER_TIME=21:00

# Zona horaria del scheduler (usa nombre de la base de datos tz, p.ej. America/Monterrey)
TIMEZONE=America/Mexico_City
